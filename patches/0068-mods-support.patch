+    }
+    for (int i = 0; i < g_nmnt; i++) {
+        if (g_mnt[i].img) {
+            romfs_image_close(g_mnt[i].img);
+            g_mnt[i].img = NULL;
+        }
+    }
+    memset(g_mnt, 0, sizeof g_mnt);
+    g_nmnt = 0;
+    pthread_mutex_unlock(&g_lock);
