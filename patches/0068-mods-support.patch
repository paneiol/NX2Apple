diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index ca8c6f1..d0a2bcb 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -13,6 +13,7 @@
 #include <fcntl.h>
 #include <sys/stat.h>
 #include <unistd.h>
+#include <strings.h>
 #include <stdio.h>
 #include <stdatomic.h>
 #include <sys/clonefile.h>
@@ -178,6 +179,108 @@ static int img_path(const char *p, int *mi, int64_t *k) {
     return 0;
 }
 static void save_old_names(const char *from, const char *to);
+// ---- Mods: DM_MODS_DIR ----
+// The folders that hold mods, colon-separated (the iOS app's Documents/mods/<title ID>, then the app's own). Every
+// subfolder is one mod: its romfs/ is the overlay root when it has one, else the mod folder itself when it holds data
+// (a code-only mod adds nothing at run time). A folder that is one mod itself (it has romfs/) is taken as one too.
+// Names are sorted, so the order is stable; the explicit DM_ROMFS_OVERLAY roots come first and win over the mods, and
+// among the mods the first root with a path wins. The scratch paths are on the heap: the mount take-overs run on the
+// game's own stack, which can be as small as 8 KB.
+static int overlay_add(char *out, size_t n, const char *root) {
+    size_t len = strlen(out), rl = strlen(root);
+    if (len + (len ? 1 : 0) + rl + 1 > n) { errno = ENAMETOOLONG; return 0; }
+    if (len) out[len++] = ':';
+    memcpy(out + len, root, rl + 1);
+    return 1;
+}
+static int mod_name_cmp(const void *a, const void *b) { return strcmp(*(const char *const *)a, *(const char *const *)b); }
+static int has_subdir(const char *root, const char *name, char *p, size_t pn) {
+    struct stat st;
+    snprintf(p, pn, "%s/%s", root, name);
+    return !stat(p, &st) && S_ISDIR(st.st_mode);
+}
+// A mod folder without romfs/ is its own overlay root when it holds data (anything but the code folders and a
+// README). A code-only mod has nothing to layer, and its exefs/ must not show up under rom:/.
+static int mod_has_data(const char *mod, char *p, size_t pn) {
+    DIR *d = opendir(mod);
+    if (!d) return 0;
+    int data = 0; struct dirent *e; struct stat st;
+    while (!data && (e = readdir(d))) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..") || e->d_name[0] == '.') continue;
+        if (!strcasecmp(e->d_name, "exefs") || !strcasecmp(e->d_name, "exefs_patches") ||
+            !strcasecmp(e->d_name, "contents")) continue;
+        snprintf(p, pn, "%s/%s", mod, e->d_name);
+        if (stat(p, &st) || !S_ISREG(st.st_mode)) { data = 1; break; }
+        const char *dot = strrchr(e->d_name, '.');
+        if (dot && (!strcasecmp(dot, ".txt") || !strcasecmp(dot, ".md") || !strcasecmp(dot, ".json") ||
+                    !strcasecmp(dot, ".toml") || !strcasecmp(dot, ".ini"))) continue;
+        data = 1;
+    }
+    closedir(d);
+    return data;
+}
+static void add_mods_to_overlay(char *out, size_t n) {
+    const char *dirs = getenv("DM_MODS_DIR");
+    if (!dirs || !*dirs) return;
+    char *copy = strdup(dirs), *mod = malloc(4096), *tmp = malloc(4096);
+    if (!copy || !mod || !tmp) { free(copy); free(mod); free(tmp); return; }
+    int full = 0;
+    char *save = NULL;
+    for (char *root = strtok_r(copy, ":", &save); root && !full; root = strtok_r(NULL, ":", &save)) {
+        struct stat st;
+        snprintf(tmp, 4096, "%s/romfs", root);
+        if (!stat(tmp, &st) && S_ISDIR(st.st_mode)) {   // the root is one mod itself: no subfolders to scan
+            if (!overlay_add(out, n, tmp)) full = 1;
+            continue;
+        }
+        // the root is one mod with code (exefs/…): its data layers flat, and its exefs/ must not be scanned as a
+        // mod of its own; contents/ is the Atmosphère level above the title, not a mods folder
+        if (has_subdir(root, "exefs", tmp, 4096) || has_subdir(root, "ExeFS", tmp, 4096) ||
+            has_subdir(root, "exefs_patches", tmp, 4096) || has_subdir(root, "ExeFS_patches", tmp, 4096) ||
+            has_subdir(root, "contents", tmp, 4096)) {
+            if (mod_has_data(root, tmp, 4096) && !overlay_add(out, n, root)) full = 1;
+            continue;
+        }
+        DIR *d = opendir(root);
+        if (!d) { LOG("mods: %s cannot be opened (errno=%d)", root, errno); continue; }
+        char **names = NULL; size_t nn = 0, cap = 0; struct dirent *e;
+        while ((e = readdir(d))) {
+            if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..") || e->d_name[0] == '.') continue;
+            snprintf(tmp, 4096, "%s/%s", root, e->d_name);
+            if (stat(tmp, &st) || !S_ISDIR(st.st_mode)) continue;
+            if (nn == cap) {
+                char **q = realloc(names, (cap = cap ? cap * 2 : 8) * sizeof *q);
+                if (!q) break;
+                names = q;
+            }
+            if (!(names[nn] = strdup(e->d_name))) break;
+            nn++;
+        }
+        closedir(d);
+        if (nn) qsort(names, nn, sizeof *names, mod_name_cmp);
+        for (size_t i = 0; i < nn; i++) {
+            snprintf(mod, 4096, "%s/%s", root, names[i]);
+            snprintf(tmp, 4096, "%s/romfs", mod);
+            const char *use = NULL;
+            if (!stat(tmp, &st) && S_ISDIR(st.st_mode)) use = tmp;
+            else if (mod_has_data(mod, tmp, 4096)) use = mod;
+            int ok = use ? overlay_add(out, n, use) : 1;
+            free(names[i]);
+            if (!ok) { for (size_t j = i + 1; j < nn; j++) free(names[j]); full = 1; break; }
+        }
+        free(names);
+    }
+    if (full) LOG("[RED] mods: DM_MODS_DIR names more roots than the overlay list holds; the rest are ignored");
+    free(copy); free(mod); free(tmp);
+}
+// The rom mount's overlay: the explicit DM_ROMFS_OVERLAY roots first, then the mods folders'.
+static void rom_overlay_env(char *out, size_t n) {
+    out[0] = 0;
+    const char *explicit = getenv("DM_ROMFS_OVERLAY");
+    if (explicit) strlcpy(out, explicit, n);
+    add_mods_to_overlay(out, n);
+}
+
 static Result mount_ex(const char *name, const char *dir, int ro, int txn) {
     pthread_once(&g_txn_lock_once, txn_locks_init);
     PATH_LOCK(); pthread_mutex_lock(&g_lock);
@@ -195,8 +298,7 @@ static Result mount_ex(const char *name, const char *dir, int ro, int txn) {
     g_mnt[g_nmnt].txn_root = -1;
     atomic_store(&g_mnt[g_nmnt].poison, 0);
     atomic_store(&g_mnt[g_nmnt].first_write_ns, 0);
-    const char *overlay = !strcmp(name, "rom") ? getenv("DM_ROMFS_OVERLAY") : NULL;
-    if (overlay) strlcpy(g_mnt[g_nmnt].overlay, overlay, sizeof g_mnt[0].overlay);
+    if (!strcmp(name, "rom")) rom_overlay_env(g_mnt[g_nmnt].overlay, sizeof g_mnt[0].overlay);
     // The transaction directory cannot be set up (leftovers cannot be cleared / clone failed, which really happens on a full disk): do not exit; mount the committed directory read-only -- saves still read, every write fails, commits are no-ops, the committed version is untouched, and the front end is told
     // (each of these three failures used to call die: with the phone's storage full the game exited as soon as it mounted its saves)
     int txn_err = 0, k = 0;
@@ -549,11 +651,10 @@ HLE_FORCE("_ZN2nn2fs22QueryMountRomCacheSizeEPm", "fsp-srv; rom reads the host d
 HLE_FORCE("_ZN2nn2fs8MountRomEPKcPvm", "fsp-srv; rom → host RomFS directory", Result, h_fs_MountRom, const char *name, void *cache, size_t sz) { dm_thread_service_request();
     (void)cache; (void)sz; char b[1024];
     Result r = mount(name, envdir("DM_ROMFS", "romfs", b, sizeof b), 1);
-    const char *overlay = getenv("DM_ROMFS_OVERLAY");
-    if (r == RES_OK && overlay) {
+    if (r == RES_OK) {
         PATH_LOCK();
         for (int i = 0; i < g_nmnt; i++) if (mnt_named(&g_mnt[i], name)) {
-            strlcpy(g_mnt[i].overlay, overlay, sizeof g_mnt[i].overlay); break;
+            rom_overlay_env(g_mnt[i].overlay, sizeof g_mnt[i].overlay); break;
         }
     }
     return r;
