@@ -0,0 +1,583 @@
+#!/usr/bin/env python3
+"""Apply a game's mods to a rewritten module folder.
+
+Usage: mod_apply.py <mods folder> <ExeFS dir> <patched dir> [--title <title ID>] [--allow-conflicts] [--dry-run]
+
+A mods folder holds one subfolder per mod (the iOS app's Documents/mods/<title ID>). A mod may carry:
+  · romfs/ (or loose files): data the host layers over RomFS at run time; this tool only lists it,
+  · exefs/<module> (a full NSO) or <module>.nso: a replaced module,
+  · exefs/<module>.ips, exefs/<module>.pchtxt, or <build ID>.ips: a patch of a module.
+Atmosphère's exefs_patches/<name>/<build ID>.ips and a mod's contents/<title ID>/ level are accepted too.
+
+A full replacement is staged beside the ExeFS folder (so exe_dir.parent still holds the RomFS the NRO
+collection reads) and the rewrite runs on it. IPS/pchtxt patches are applied to <module>.patched.bin
+after the rewrite, at offsets into the module's memory image (text at 0), which is what pchtxt offsets
+are and what an uncompressed NSO's file offsets are. The pristine rewrite is kept as
+<module>.patched.bin.base: every run restores it first, so a build applies each mod exactly once and a
+mod removed from the folder leaves no trace. A patch that would overwrite a word the rewriter changed
+or a registered cut is refused (its offsets are in <module>.changed.tsv and <module>.cuts.tsv): the
+platform fix would be undone. --allow-conflicts applies it anyway and says so.
+
+Build IDs are checked: a full NSO must be the build of the module it replaces, and a pchtxt's
+@nsobid- must match. IPS has no build ID in its format; its offsets are checked against the image
+size and the rewrite's tables instead.
+
+The functions are the interface the Windows front end uses (driver.py wraps rewrite() with
+prepare()/apply()); the command line does the same two steps for a build already made by hand.
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import shutil
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import nso
+
+MODULE_DIR_NAMES = ('exefs', 'ExeFS')
+PATCH_DIR_NAMES = ('exefs_patches', 'ExeFS_patches')
+HEX = set('0123456789abcdefABCDEF')
+
+
+class ModError(Exception):
+    """A mod that cannot be applied; the message says which file and why."""
+
+
+@dataclass
+class Patch:
+    mod: str
+    path: Path
+    kind: str                     # 'ips' or 'pchtxt'
+    module: str
+    records: list[tuple[int, bytes]]
+    build_id: bytes | None = None  # pchtxt's @nsobid-, when it has one
+
+    @property
+    def length(self):
+        return sum(len(d) for _, d in self.records)
+
+
+@dataclass
+class Mod:
+    name: str
+    folder: Path
+    content: Path                 # folder, or its contents/<title ID> level
+    romfs: Path | None
+    replacements: dict[str, Path] = field(default_factory=dict)
+    patches: list[Patch] = field(default_factory=list)
+
+
+@dataclass
+class Plan:
+    root: Path | None             # the game's mods folder (root/<title ID> resolved), None when unset
+    title_id: str
+    mods: list[Mod]
+    modules: list[str]
+    builds: dict[str, bytes]
+    exe_dir: Path                 # the folder the rewrite must read (staged when a module is replaced)
+    original_exe_dir: Path
+    replacements: dict[str, Path] = field(default_factory=dict)
+    patches: list[Patch] = field(default_factory=list)
+
+    @property
+    def empty(self):
+        return not self.replacements and not self.patches
+
+    def files(self):
+        """Every mod file that changes the rewrite or the image, for a stage's cache key"""
+        out = []
+        for p in self.replacements.values():
+            out.append(p)
+        for p in self.patches:
+            out.append(p.path)
+        return out
+
+    def romfs_dirs(self):
+        """(mod name, RomFS root) for the RomFS part of every mod, for the app build to bundle"""
+        return [(m.name, m.romfs) for m in self.mods if m.romfs is not None]
+
+
+# --------------------------------------------------------------------------------------------- discovery
+
+def resolve_root(folder, title_id):
+    """The folder that holds one subfolder per mod: <folder>/<title ID>, <folder>/contents/<title ID>,
+    or folder itself when it already is the game's mods folder."""
+    root = Path(folder)
+    if not root.is_dir():
+        return None
+    for cand in (root / title_id, root / 'contents' / title_id):
+        if cand.is_dir():
+            return cand
+    return root
+
+
+def _content_root(mod, title_id):
+    """A mod's contents/<title ID>/ level when it has one (an Atmosphère package), else the mod"""
+    if title_id:
+        c = mod / 'contents' / title_id
+        if c.is_dir():
+            return c
+    c = mod / 'contents'
+    if c.is_dir():
+        subs = [d for d in sorted(c.iterdir()) if d.is_dir()]
+        if len(subs) == 1:
+            return subs[0]
+    return mod
+
+
+def _is_mod_folder(p):
+    """p itself is one mod: it has romfs/, an exefs/, or an Atmosphère contents/ level (so a mods folder
+    picked one level too deep still works)"""
+    return any((p / n).is_dir() for n in ('romfs', 'contents') + MODULE_DIR_NAMES + PATCH_DIR_NAMES)
+
+
+def _mod_dirs(root):
+    """The mod folders below a mods root, in the host's order; the root itself when it is one mod."""
+    if root is None:
+        return []
+    if _is_mod_folder(root):
+        return [root]
+    return sorted((d for d in root.iterdir() if d.is_dir() and not d.name.startswith('.')),
+                  key=lambda d: d.name)
+
+
+def _romfs_root(content):
+    r = content / 'romfs'
+    if r.is_dir():
+        return r
+    # no romfs/: the mod folder itself is the overlay root, unless it only holds code
+    skip = set(MODULE_DIR_NAMES) | set(PATCH_DIR_NAMES) | {'contents'}
+    for e in content.iterdir():
+        if e.name in skip or e.name.startswith('.'):
+            continue
+        if e.is_file() and e.suffix.lower() in ('.txt', '.md', '.json', '.toml', '.ini'):
+            continue
+        return content
+    return None
+
+
+def romfs_mods(root, title_id, log=print):
+    """[(mod name, RomFS root, flat)] of every mod's data part, without reading its code.
+    flat is True when the mod folder itself is the root (no romfs/ level)."""
+    out = []
+    for mod_dir in _mod_dirs(root):
+        content = _content_root(mod_dir, title_id)
+        r = _romfs_root(content)
+        if r is not None:
+            out.append((mod_dir.name, r, r == content))
+    return out
+
+
+def _is_nso(p):
+    with open(p, 'rb') as f:
+        return f.read(4) == b'NSO0'
+
+
+def _candidate_files(content):
+    """Files of a mod that can be a module or a patch: its exefs folders, its exefs_patches folders,
+    and the files directly under the mod (a flat package)."""
+    seen, out = set(), []
+    dirs = [content / n for n in MODULE_DIR_NAMES + PATCH_DIR_NAMES if (content / n).is_dir()]
+    for d in dirs:
+        for p in sorted(d.rglob('*')):
+            if p.is_file() and p.resolve() not in seen:
+                seen.add(p.resolve())
+                out.append(p)
+    for p in sorted(content.iterdir()):
+        if p.is_file() and p.resolve() not in seen:
+            seen.add(p.resolve())
+            out.append(p)
+    return out
+
+
+def parse_ips(path):
+    """[(offset, bytes)] of an IPS or IPS32 file (the RLE record expanded)"""
+    d = Path(path).read_bytes()
+    if d[:5] == b'IPS32':
+        i, width, end = 5, 4, (b'EEOF', b'EOF')
+    elif d[:5] == b'PATCH':
+        i, width, end = 5, 3, (b'EOF', b'EEOF')
+    else:
+        raise ModError(f'{path}: not an IPS or IPS32 file')
+    recs = []
+    while i < len(d):
+        if any(d[i:i + len(e)] == e for e in end):
+            return recs
+        if i + width + 2 > len(d):
+            raise ModError(f'{path}: the IPS record at {i:#x} is cut short')
+        off = int.from_bytes(d[i:i + width], 'big')
+        size = int.from_bytes(d[i + width:i + width + 2], 'big')
+        i += width + 2
+        if size == 0:
+            if i + 3 > len(d):
+                raise ModError(f'{path}: the IPS RLE record at {i:#x} is cut short')
+            count = int.from_bytes(d[i:i + 2], 'big')
+            recs.append((off, bytes([d[i + 2]]) * count))
+            i += 3
+        else:
+            if i + size > len(d):
+                raise ModError(f'{path}: the IPS record at {off:#x} names {size} bytes past the end of the file')
+            recs.append((off, d[i:i + size]))
+            i += size
+    raise ModError(f'{path}: no IPS end marker')
+
+
+def parse_pchtxt(path):
+    """(build ID or None, [(offset, bytes)]) of a pchtxt file"""
+    bid, shift, recs = None, 0, []
+    for n, raw in enumerate(Path(path).read_text(encoding='utf-8', errors='replace').splitlines(), 1):
+        line = raw.strip()
+        if not line or line.startswith('//'):
+            continue
+        if line.startswith('@'):
+            low = line.lower()
+            if low.startswith('@nsobid-'):
+                h = line.split('-', 1)[1].strip()
+                try:
+                    bid = bytes.fromhex(h)
+                except ValueError:
+                    raise ModError(f'{path}:{n}: @nsobid- is not hex: {h}') from None
+            elif low.startswith('@flag'):
+                parts = line.split()
+                if len(parts) >= 3 and parts[1].lower() == 'offset_shift':
+                    try:
+                        shift = int(parts[2], 0)
+                    except ValueError:
+                        raise ModError(f'{path}:{n}: offset_shift is not a number: {parts[2]}') from None
+            elif low.startswith('@stop'):
+                break
+            continue
+        parts = line.split()
+        if len(parts) < 2:
+            raise ModError(f'{path}:{n}: expected "offset bytes"')
+        try:
+            off = int(parts[0], 16) + shift
+            data = bytes.fromhex(''.join(parts[1:]))
+        except ValueError:
+            raise ModError(f'{path}:{n}: not an offset and hex bytes: {line}') from None
+        if not data:
+            raise ModError(f'{path}:{n}: no bytes')
+        recs.append((off, data))
+    return bid, recs
+
+
+def _module_for(stem, path, modules, builds, pchtxt_bid):
+    if stem in modules:
+        return stem
+    low = stem.lower()
+    if len(low) >= 16 and all(c in HEX for c in low):
+        want = bytes.fromhex(low)
+        hits = [m for m in modules if builds[m].startswith(want)]
+        if len(hits) == 1:
+            return hits[0]
+        if hits:
+            raise ModError(f'{path}: the build ID names several modules ({", ".join(hits)})')
+    if pchtxt_bid:
+        hits = [m for m in modules if builds[m].startswith(pchtxt_bid)]
+        if len(hits) == 1:
+            return hits[0]
+        if hits:
+            raise ModError(f'{path}: the build ID names several modules ({", ".join(hits)})')
+    if len(modules) == 1:
+        return modules[0]
+    raise ModError(f'{path}: cannot tell which module it patches; name it <module>.ips / <module>.pchtxt '
+                   f'(the game has {", ".join(modules)})')
+
+
+def discover(root, title_id, modules, builds, log=print):
+    """The mods of root/<title ID> (or root), sorted by folder name as the host layers them"""
+    mods = []
+    for mod_dir in _mod_dirs(root):
+        content = _content_root(mod_dir, title_id)
+        m = Mod(mod_dir.name, mod_dir, content, _romfs_root(content))
+        for p in _candidate_files(content):
+            suffix = p.suffix.lower()
+            name = p.name
+            if suffix == '.ips':
+                module = _module_for(p.stem, p, modules, builds, None)
+                recs = parse_ips(p)
+                m.patches.append(Patch(m.name, p, 'ips', module, recs))
+            elif suffix == '.pchtxt':
+                bid, recs = parse_pchtxt(p)
+                module = _module_for(p.stem, p, modules, builds, bid)
+                if bid and not builds[module].startswith(bid):
+                    raise ModError(f'{p}: built for {bid.hex()}, but {module} is {builds[module][:len(bid)].hex()}')
+                m.patches.append(Patch(m.name, p, 'pchtxt', module, recs, bid))
+            elif suffix == '.nso':
+                module = _module_for(p.stem, p, modules, builds, None)
+                m.replacements[module] = p
+            elif suffix == '' and _is_nso(p):
+                module = _module_for(name, p, modules, builds, None)
+                m.replacements[module] = p
+        if m.replacements or m.patches or m.romfs:
+            mods.append(m)
+        else:
+            log(f'mods: {mod_dir} has no romfs/, exefs/ module or patch; skipped')
+    return mods
+
+
+# --------------------------------------------------------------------------------------------- staging
+
+def _link_or_copy(src, dst):
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        dst.unlink()
+    except FileNotFoundError:
+        pass
+    try:
+        os.link(src, dst)
+    except OSError:
+        shutil.copy2(src, dst)
+
+
+def _stage_exefs(exe_dir, replacements):
+    """A sibling of exe_dir holding every file of it, with the replaced modules swapped in: exe_dir.parent
+    (the version folder with the RomFS) is unchanged, which collect_nros needs"""
+    staged = exe_dir.with_name(exe_dir.name + '_mods')
+    shutil.rmtree(staged, ignore_errors=True)
+    staged.mkdir(parents=True)
+    for p in exe_dir.iterdir():
+        if p.is_file():
+            _link_or_copy(p, staged / p.name)
+    for module, src in replacements.items():
+        _link_or_copy(src, staged / module)
+    (staged / '.dm_mods_staged').write_text('', encoding='utf-8')
+    return staged
+
+
+def prepare(exe_dir, mods_folder, title_id, modules, log=print):
+    """Discover the mods and stage full module replacements. Returns a Plan; the rewrite must read
+    plan.exe_dir (the original folder when nothing is replaced)."""
+    exe_dir = Path(exe_dir)
+    root = resolve_root(mods_folder, title_id) if mods_folder else None
+    if not _mod_dirs(root):   # no mods folder, or one with nothing in it: no module is read
+        return Plan(root, title_id, [], list(modules), {}, exe_dir, exe_dir)
+    builds = {}
+    for m in modules:
+        p = exe_dir / m
+        if not p.is_file():
+            raise ModError(f'{p}: no module to compare a mod against')
+        builds[m] = nso.load(p.read_bytes(), m).build_id
+    mods = discover(root, title_id, modules, builds, log)
+    plan = Plan(root, title_id, mods, list(modules), builds, exe_dir, exe_dir)
+    for m in mods:
+        for module, src in sorted(m.replacements.items()):
+            want = builds[module]
+            got = nso.load(src.read_bytes(), str(src)).build_id
+            if got != want:
+                raise ModError(f'{src}: {module} is build {want[:0x10].hex()}, the mod replaces {got[:0x10].hex()} '
+                               f'(a full NSO replacement must be the same build)')
+            if module in plan.replacements:
+                first = next(x for x in mods if plan.replacements[module] in x.replacements.values())
+                log(f'mods: {m.name} also replaces {module}; {first.name} wins (folder order)')
+                continue
+            plan.replacements[module] = src
+        for p in m.patches:
+            if p.module in plan.replacements:
+                # a patch of a module the same or an earlier mod replaces: it applies to the rewritten replacement
+                pass
+            plan.patches.append(p)
+    if plan.replacements:
+        if not (exe_dir / '.dm_mods_staged').is_file():   # a nested rewrite (NRO capture) already reads a staged folder
+            plan.exe_dir = _stage_exefs(exe_dir, plan.replacements)
+        log(f'mods: {len(plan.replacements)} module(s) replaced: {", ".join(sorted(plan.replacements))}')
+    for m in mods:
+        parts = []
+        if m.romfs:
+            parts.append(f'romfs {m.romfs}')
+        if m.replacements:
+            parts.append('replaces ' + ', '.join(sorted(m.replacements)))
+        if m.patches:
+            parts.append('patches ' + ', '.join(sorted({p.module for p in m.patches})))
+        log(f'mods: {m.name}: ' + '; '.join(parts))
+    return plan
+
+
+# --------------------------------------------------------------------------------------------- applying
+
+def _read_runs(path):
+    """[(offset, length)] of a table with "# key" headers and offset/length columns (changed.tsv)"""
+    out = []
+    if not Path(path).is_file():
+        return out
+    for line in Path(path).read_text(encoding='utf-8', errors='replace').splitlines():
+        if not line or line.startswith('#'):
+            continue
+        c = line.split('\t')
+        try:
+            out.append((int(c[0], 0), int(c[1], 0)))
+        except (ValueError, IndexError):
+            continue
+    return out
+
+
+def _read_cuts(path):
+    """[(offset, length, reason)] of a cuts.tsv"""
+    out = []
+    if not Path(path).is_file():
+        return out
+    for line in Path(path).read_text(encoding='utf-8', errors='replace').splitlines():
+        if not line or line.startswith('#'):
+            continue
+        c = line.split('\t')
+        try:
+            out.append((int(c[0], 0), max(len(c[1]), len(c[2])) // 2, c[3] if len(c) > 3 else ''))
+        except (ValueError, IndexError):
+            continue
+    return out
+
+
+def _overlaps(a, n, runs):
+    return [r for r in runs if a < r[0] + r[1] and r[0] < a + n]
+
+
+def _rewrite_key(patched):
+    k = Path(patched).with_name(Path(patched).name + '.key')
+    try:
+        return k.read_text(encoding='utf-8').partition('\n')[0]
+    except OSError:
+        return ''
+
+
+def apply(plan, patched_dir, log=print, allow_conflicts=False, dry_run=False):
+    """Apply plan.patches to <module>.patched.bin, keeping the pristine rewrite in .base.
+    Returns the number of patches applied (0 when the plan is empty)."""
+    patched_dir = Path(patched_dir)
+    patched = {}
+    for p in plan.patches:
+        patched.setdefault(p.module, []).append(p)
+    key = _rewrite_key(patched_dir)
+    stamp = patched_dir / 'mods.base.key'
+    try:
+        same = stamp.is_file() and stamp.read_text(encoding='utf-8') == key
+    except OSError:
+        same = False
+    if not patched:
+        # no mod patches a module now: restore the pristine rewrite when the rewrite was reused, or
+        # drop the bases when it ran again (they are then from an older rewrite)
+        for base in sorted(patched_dir.glob('*.patched.bin.base')):
+            module = base.name[:-len('.patched.bin.base')]
+            out = patched_dir / f'{module}.patched.bin'
+            if same and out.is_file():
+                if not dry_run:
+                    shutil.copyfile(base, out)
+                    log(f'mods: {module}: restored the rewrite (no mod patches it now)')
+            elif not dry_run:
+                base.unlink()
+        return 0
+    if not same:
+        # the rewrite ran again: its output is pristine, so it becomes the new base
+        for base in patched_dir.glob('*.patched.bin.base'):
+            base.unlink()
+        for module in patched:
+            out = patched_dir / f'{module}.patched.bin'
+            if not out.is_file():
+                raise ModError(f'{out}: the rewrite did not produce it')
+            if not dry_run:
+                shutil.copyfile(out, patched_dir / f'{module}.patched.bin.base')
+        if not dry_run:
+            stamp.write_text(key, encoding='utf-8')
+
+    applied = 0
+    for module, patches in sorted(patched.items()):
+        out = patched_dir / f'{module}.patched.bin'
+        base = patched_dir / f'{module}.patched.bin.base'
+        if not out.is_file():
+            raise ModError(f'{out}: the rewrite did not produce it')
+        if not base.is_file():
+            if not dry_run:
+                shutil.copyfile(out, base)
+        if not dry_run:
+            shutil.copyfile(base, out)
+        buf = bytearray((base if base.is_file() else out).read_bytes())
+        changed = _read_runs(patched_dir / f'{module}.changed.tsv')
+        cuts = _read_cuts(patched_dir / f'{module}.cuts.tsv')
+        for p in patches:
+            conflicts = []
+            for off, data in p.records:
+                if off < 0 or off + len(data) > len(buf):
+                    raise ModError(f'{p.path}: {module}+{off:#x} + {len(data)} bytes is past the image ({len(buf):#x})')
+                if buf[off:off + len(data)] == data:
+                    continue   # already what the mod writes: no change, and no conflict
+                for r in _overlaps(off, len(data), changed):
+                    conflicts.append((off, len(data), f'rewriter change at {r[0]:#x}+{r[1]:#x}'))
+                for r in _overlaps(off, len(data), cuts):
+                    conflicts.append((off, len(data), f'cut at {r[0]:#x} ({r[2]})'))
+                if not dry_run:
+                    buf[off:off + len(data)] = data
+            if conflicts:
+                lines = '\n'.join(f'  {p.path}: {module}+{o:#x}+{n:#x} overlaps {why}' for o, n, why in conflicts)
+                if not allow_conflicts:
+                    raise ModError(f'{module}: the mod writes over a platform fix, which would undo it '
+                                   f'(pass --allow-conflicts to apply it anyway):\n{lines}')
+                log(f'mods: {module}: --allow-conflicts, applying over a platform fix:\n{lines}')
+            log(f'mods: {module}: {p.mod} {p.kind} {p.path.name} ({len(p.records)} record(s), {p.length} bytes)')
+            applied += 1
+        if not dry_run:
+            out.write_bytes(buf)
+    return applied
+
+
+def mod_files(mods_folder, title_id, exe_dir, modules, log=lambda *a: None):
+    """Every mod file that changes the rewrite, for a stage's cache key (never raises)"""
+    try:
+        exe_dir = Path(exe_dir)
+        root = resolve_root(mods_folder, title_id) if mods_folder else None
+        if not _mod_dirs(root):
+            return []
+        builds = {m: nso.load((exe_dir / m).read_bytes(), m).build_id for m in modules}
+        mods = discover(root, title_id, modules, builds, log)
+        return [p for m in mods for p in m.replacements.values()] + [p.path for m in mods for p in m.patches]
+    except Exception:
+        return []
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(prog='mod_apply.py', description=__doc__.splitlines()[0])
+    ap.add_argument('mods', help='the mods folder (one subfolder per mod, or <title ID>/ below it)')
+    ap.add_argument('exe_dir', help='the version\'s ExeFS folder')
+    ap.add_argument('patched', help='the rewritten modules folder (patched_<package>)')
+    ap.add_argument('--title', default=None, help='the base game title ID (default: the mods folder itself)')
+    ap.add_argument('--allow-conflicts', action='store_true',
+                    help='apply a patch that overwrites a rewriter change or a cut, instead of refusing it')
+    ap.add_argument('--dry-run', action='store_true', help='check the mods and say what would happen')
+    a = ap.parse_args(argv)
+    if not Path(a.mods).is_dir():
+        ap.error(f'{a.mods}: not a folder')
+    title = a.title
+    if not title:
+        # a folder named like a title ID (16 hex digits) is taken as one; else the one title folder
+        # below it, so `mods` with a single game's folder works as well as the game's own folder
+        name = Path(a.mods).name
+        if len(name) == 16 and all(c in HEX for c in name):
+            title = name
+        else:
+            try:
+                subs = [d.name for d in Path(a.mods).iterdir()
+                        if d.is_dir() and len(d.name) == 16 and all(c in HEX for c in d.name)]
+            except OSError:
+                subs = []
+            if len(subs) > 1:
+                ap.error(f'{a.mods} holds {len(subs)} title folders; pass --title <title ID>')
+            title = subs[0] if subs else ''
+    exe_dir = Path(a.exe_dir)
+    modules = [p.name for p in sorted(exe_dir.iterdir()) if p.is_file() and _is_nso(p)]
+    try:
+        plan = prepare(exe_dir, a.mods, title, modules, log=lambda s: print(s, file=sys.stderr))
+        n = apply(plan, a.patched, log=lambda s: print(s, file=sys.stderr), allow_conflicts=a.allow_conflicts,
+                  dry_run=a.dry_run)
+    except (ModError, ValueError) as e:
+        print(f'[RED] mods: {e}', file=sys.stderr)
+        return 1
+    print(f'mods: {len(plan.mods)} mod(s), {len(plan.replacements)} replaced module(s), {n} patch(es)'
+          + (' (dry run)' if a.dry_run else ''), file=sys.stderr)
+    for name, r in plan.romfs_dirs():
+        print(f'mods: {name}: romfs {r}', file=sys.stderr)
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
