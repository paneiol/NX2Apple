+"""Mods (dm/tools/mod_apply.py): the IPS/IPS32 and pchtxt parsers, the layouts a mods folder may use,
+and the apply step's base copy, conflict refusal and restore when a mod is removed. No game files."""
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import mod_apply
+
+BID = bytes.fromhex('ABCDEF0123456789' + '00' * 24)
+
+
+def ips16(records, rle=None):
+    """A PATCH IPS file: records are (offset, bytes); rle is (offset, count, byte)"""
+    out = bytearray(b'PATCH')
+    for off, data in records:
+        out += off.to_bytes(3, 'big') + len(data).to_bytes(2, 'big') + data
+    if rle:
+        off, count, val = rle
+        out += off.to_bytes(3, 'big') + b'\0\0' + count.to_bytes(2, 'big') + bytes([val])
+    return bytes(out + b'EOF')
+
+
+class Parsers(unittest.TestCase):
+    def test_ips_and_ips32(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = Path(d, 'main.ips')
+            p.write_bytes(ips16([(0x10, b'abc')], rle=(0x20, 4, 0xAA)))
+            self.assertEqual(mod_apply.parse_ips(p), [(0x10, b'abc'), (0x20, b'\xAA' * 4)])
+            q = Path(d, 'main32.ips')
+            q.write_bytes(b'IPS32' + (0x1234).to_bytes(4, 'big') + (2).to_bytes(2, 'big') + b'xy' + b'EEOF')
+            self.assertEqual(mod_apply.parse_ips(q), [(0x1234, b'xy')])
+            r = Path(d, 'bad.ips')
+            r.write_bytes(b'PATCH' + (0x10).to_bytes(3, 'big') + (3).to_bytes(2, 'big') + b'a')
+            with self.assertRaises(mod_apply.ModError):
+                mod_apply.parse_ips(r)
+
+    def test_pchtxt(self):
+        with tempfile.TemporaryDirectory() as d:
+            p = Path(d, 'main.pchtxt')
+            p.write_text('// a comment\n@nsobid-ABCDEF0123456789\n@flag offset_shift 0x100\n'
+                         '0010 DE AD BE EF\n0020 01 02\n@stop\n0030 FF\n')
+            bid, recs = mod_apply.parse_pchtxt(p)
+            self.assertEqual(bid, bytes.fromhex('ABCDEF0123456789'))
+            self.assertEqual(recs, [(0x110, bytes.fromhex('DEADBEEF')), (0x120, b'\x01\x02')])
+            bad = Path(d, 'bad.pchtxt')
+            bad.write_text('0010 ZZ\n')
+            with self.assertRaises(mod_apply.ModError):
+                mod_apply.parse_pchtxt(bad)
+
+
+class Discovery(unittest.TestCase):
+    def test_layouts(self):
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d, 'mods', '0100ABCD')
+            (root / 'a' / 'romfs' / 'data').mkdir(parents=True)
+            (root / 'a' / 'romfs' / 'data' / 'x').write_text('1')
+            (root / 'b' / 'exefs').mkdir(parents=True)
+            (root / 'b' / 'exefs' / 'main.ips').write_bytes(ips16([(0, b'\x00')]))
+            (root / 'c' / 'contents' / '0100ABCD' / 'romfs').mkdir(parents=True)
+            (root / 'c' / 'contents' / '0100ABCD' / 'romfs' / 'y').write_text('2')
+            (root / 'd' / 'exefs_patches' / 'a patch').mkdir(parents=True)
+            (root / 'd' / 'exefs_patches' / 'a patch' / 'ABCDEF0123456789.ips').write_bytes(ips16([(0, b'\x00')]))
+            (root / 'e' / 'exefs').mkdir(parents=True)
+            (root / 'e' / 'exefs' / 'main').write_bytes(b'NSO0' + b'\0' * 64)
+            mods = mod_apply.discover(root, '0100ABCD', ['main'], {'main': BID}, log=lambda *a: None)
+            by = {m.name: m for m in mods}
+            self.assertEqual(by['a'].romfs, root / 'a' / 'romfs')
+            self.assertEqual(by['c'].romfs, root / 'c' / 'contents' / '0100ABCD' / 'romfs')
+            self.assertEqual(by['b'].patches[0].module, 'main')
+            self.assertEqual(by['d'].patches[0].module, 'main')   # named by build ID
+            self.assertEqual(by['e'].replacements['main'], root / 'e' / 'exefs' / 'main')
+
+    def test_flat_mod_is_its_own_romfs(self):
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d, 'mods')
+            (root / 'flat' / 'data').mkdir(parents=True)
+            (root / 'flat' / 'data' / 'x').write_text('1')
+            (root / 'flat' / 'exefs').mkdir()
+            mods = mod_apply.romfs_mods(root, '', log=lambda *a: None)
+            self.assertEqual(mods, [('flat', root / 'flat', True)])
+
+    def test_root_that_is_one_mod(self):
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d, 'My Mod')
+            (root / 'romfs' / 'data').mkdir(parents=True)
+            (root / 'exefs').mkdir()
+            (root / 'exefs' / 'main.ips').write_bytes(ips16([(0, b'\x00')]))
+            mods = mod_apply.discover(root, '0100ABCD', ['main'], {'main': BID}, log=lambda *a: None)
+            self.assertEqual([m.name for m in mods], ['My Mod'])
+            self.assertEqual(mods[0].romfs, root / 'romfs')
+            self.assertEqual(mods[0].patches[0].module, 'main')
+            self.assertEqual(mod_apply.romfs_mods(root, '0100ABCD'), [('My Mod', root / 'romfs', False)])
+
+
+def fake_nso(build_id):
+    """A minimal valid NSO: three uncompressed 4 KiB segments, no hashes, the build ID at +0x40"""
+    import struct
+    h = bytearray(0x100)
+    h[0:4] = b'NSO0'
+    struct.pack_into('<I', h, 0xc, 0)
+    for i in range(3):
+        struct.pack_into('<III', h, 0x10 + i * 0x10, i * 0x1000, i * 0x1000, 0x1000)
+    struct.pack_into('<I', h, 0x3c, 0)
+    h[0x40:0x60] = build_id
+    return bytes(h) + b'\0' * 0x3000
+
+
+class Staging(unittest.TestCase):
+    def test_prepare_stages_and_checks_build_id(self):
+        with tempfile.TemporaryDirectory() as d:
+            exe = Path(d, 'v0', 'ExeFS')
+            exe.mkdir(parents=True)
+            (exe / 'main').write_bytes(fake_nso(BID))
+            (exe / 'sdk').write_bytes(fake_nso(BID))
+            mods = Path(d, 'mods', '0100ABCD')
+            (mods / 'm' / 'exefs').mkdir(parents=True)
+            (mods / 'm' / 'exefs' / 'main').write_bytes(fake_nso(BID))
+            (mods / 'm' / 'romfs').mkdir()
+            (mods / 'm' / 'romfs' / 'x').write_text('1')
+            plan = mod_apply.prepare(exe, Path(d, 'mods'), '0100ABCD', ['main', 'sdk'], log=lambda *a: None)
+            self.assertEqual(plan.exe_dir.name, 'ExeFS_mods')
+            self.assertEqual((plan.exe_dir / 'main').read_bytes(), (mods / 'm' / 'exefs' / 'main').read_bytes())
+            self.assertEqual((plan.exe_dir / 'sdk').read_bytes(), (exe / 'sdk').read_bytes())
+            self.assertEqual(plan.romfs_dirs(), [('m', mods / 'm' / 'romfs')])
+            (mods / 'm' / 'exefs' / 'main').write_bytes(fake_nso(bytes(32)))
+            with self.assertRaises(mod_apply.ModError):
+                mod_apply.prepare(exe, Path(d, 'mods'), '0100ABCD', ['main', 'sdk'], log=lambda *a: None)
+
+
+class Applying(unittest.TestCase):
+    def _plan(self, out, patches):
+        mod = mod_apply.Mod('m', out, out, None, patches=patches)
+        return mod_apply.Plan(out, 'X', [mod], ['main'], {'main': BID}, out, out, patches=patches)
+
+    def test_base_conflict_and_restore(self):
+        with tempfile.TemporaryDirectory() as d:
+            out = Path(d, 'patched')
+            out.mkdir()
+            pristine = bytes(range(256))
+            (out / 'main.patched.bin').write_bytes(pristine)
+            (out / 'main.changed.tsv').write_text('# BUILD_ID\tX\n0x20\t0x4\n')
+            (out / 'main.cuts.tsv').write_text('# BUILD_ID\tX\n0x30\t00000000\t00000000\tnop\n')
+            patch = mod_apply.Patch('m', Path(d, 'main.ips'), 'ips', 'main', [(0x10, b'AB')])
+            plan = self._plan(out, [patch])
+            mod_apply.apply(plan, out, log=lambda *a: None)
+            self.assertEqual((out / 'main.patched.bin').read_bytes()[0x10:0x12], b'AB')
+            self.assertEqual((out / 'main.patched.bin.base').read_bytes(), pristine)
+            mod_apply.apply(plan, out, log=lambda *a: None)   # again: applied once, not twice
+            self.assertEqual((out / 'main.patched.bin').read_bytes()[0x10:0x12], b'AB')
+            patch.records = [(0x20, b'ZZ')]
+            with self.assertRaises(mod_apply.ModError):
+                mod_apply.apply(plan, out, log=lambda *a: None)
+            mod_apply.apply(plan, out, log=lambda *a: None, allow_conflicts=True)
+            self.assertEqual((out / 'main.patched.bin').read_bytes()[0x20:0x22], b'ZZ')
+            plan.patches = []   # the mod is gone: the pristine rewrite comes back
+            mod_apply.apply(plan, out, log=lambda *a: None)
+            self.assertEqual((out / 'main.patched.bin').read_bytes(), pristine)
+
+
+if __name__ == '__main__':
+    unittest.main()
