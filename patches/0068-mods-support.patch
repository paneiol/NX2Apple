+void dm_fs_teardown(void) {
+    pthread_mutex_lock(&g_lock);
+    for (int fd = 3; fd < 65536; fd++) {
+        if (g_fmode[fd]) {
+            close(fd);
+            g_fmode[fd] = 0;
+            atomic_store(&g_ftxn[fd], 0);
