+        windows_path = r'C:\game\b-test.img\data\file.json'
+        file_stat = SimpleNamespace(st_mode=stat.S_IFREG, st_ino=0, st_size=0, st_mtime_ns=0, st_ctime_ns=0)
+        with patch.object(romfs._os, 'sep', '\\'), \
+                patch.object(romfs._os.path, 'abspath', return_value=windows_path), \
+                patch.object(romfs._os, 'stat', return_value=file_stat), \
+                patch.object(romfs, '_image', return_value=loaded) as image:
+            resolved = romfs._resolve('ignored')
+        self.assertEqual(resolved, (loaded, 'data/file.json'))
+        self.assertEqual(image.call_args.args[0], 'C:/game/b-test.img')
+
+    def test_readinto_without_pread_uses_the_readers_own_descriptor(self):
+        no_pread = SimpleNamespace(lseek=os.lseek, read=os.read, SEEK_SET=os.SEEK_SET)
+        with romfs.open(self.virtual / 'data/archive', 'rb') as f:
+            with patch.object(romfs, '_os', no_pread):
+                self.assertEqual(f.read(100), self.data[:100])
