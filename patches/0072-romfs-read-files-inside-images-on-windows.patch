From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paneiol <pane1029384756@gmail.com>
Date: Sat, 28 Nov 2026 16:52:16 +0100
Subject: [PATCH] romfs: read files inside images on Windows

Normalize abspath's backslashes before splitting for the .img component, use lseek+read where pread is unavailable, and open the image descriptor with O_BINARY. Child reads previously fell through to a nonexistent literal path; the text descriptor also collapsed CRLF and desynchronized indexed offsets. Add cross-platform regressions for separator resolution and the no-pread path.

Upstream-Status: pending
Reason: Fast refresh and shader-library reads on Windows: RomFS image children resolve and read as binary despite no pread
Issue: none

---
 dm/tools/romfs.py                 | 15 ++++++++++++---
 dm/tools/tests/test_romfs_read.py | 20 ++++++++++++++++++++
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/dm/tools/romfs.py b/dm/tools/romfs.py
index 50644ae..ae76690 100644
--- a/dm/tools/romfs.py
+++ b/dm/tools/romfs.py
@@ -145,7 +145,9 @@ def is_image(path):
 
 def _resolve(path):
     p = _os.path.abspath(_os.fsdecode(path))
-    parts = p.split('/')
+    # Windows returns backslashes from abspath(); normalize them before looking for the .img
+    # component, or only the image itself resolves and every child read falls through to the disk.
+    parts = p.replace(_os.sep, '/').split('/')
     for i, part in enumerate(parts):
         if not part.endswith('.img'): continue
         image = '/'.join(parts[:i + 1])
@@ -167,7 +169,9 @@ _fd_ranges = {}
 
 class _File(io.RawIOBase):
     def __init__(self, image, k):
-        self.fd = _os.open(image.path, _os.O_RDONLY)
+        # O_BINARY matters on Windows: a text descriptor collapses CRLF and desynchronizes pos
+        # from the byte offsets in the image index (and then reads the next entry's bytes).
+        self.fd = _os.open(image.path, _os.O_RDONLY | getattr(_os, 'O_BINARY', 0))
         a, self.length = image.entry(k)[:2]
         self.start = image.slice_offset + a
         self.pos = 0
@@ -182,7 +186,12 @@ class _File(io.RawIOBase):
         self.pos = pos; return pos
     def readinto(self, buffer):
         size = min(len(buffer), max(0, self.length - self.pos))
-        data = _os.pread(self.fd, size, self.start + self.pos)
+        if hasattr(_os, 'pread'):
+            data = _os.pread(self.fd, size, self.start + self.pos)
+        else:
+            # Windows has no pread. Each reader owns its descriptor, so moving its offset is safe.
+            _os.lseek(self.fd, self.start + self.pos, _os.SEEK_SET)
+            data = _os.read(self.fd, size)
         buffer[:len(data)] = data; self.pos += len(data)
         return len(data)
     def close(self):
